{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "web",
      "request": "launch",
      "type": "dart","program": "app/lib/main.dart",
      "args": [
        "-d",
        "chrome",
        "web-port",
        "3333"
      ]
    },
        {
          "type": "node",
          "request": "launch",
          "name": "Run Sanity Server",
          "program": "${workspaceFolder}/sanity_studio/node_modules/@sanity/cli/bin/sanity.js",
          "args": ["start"],
          "cwd": "${workspaceFolder}",
          "console": "integratedTerminal"
        },
      
    
    {
      "name": "mark_1 (profile mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile"
    },
    {
      "name": "mark_1 (release mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release"
    }
  ]
}